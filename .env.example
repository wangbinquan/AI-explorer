# DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 163 邮箱：FROM 必须是完整 163 邮箱地址；
# PASSWORD 是「客户端授权密码」（在 163 网页端 设置 → POP3/SMTP/IMAP 中开启并获取），不是登录密码。
EMAIL_FROM=your_account@163.com
EMAIL_PASSWORD=your_163_smtp_auth_code
EMAIL_TO=your_inbox@example.com
# 多人收件：用逗号、分号或空格分隔，例如
# EMAIL_TO=alice@example.com, bob@example.com; carol@example.com

# 可选：GitHub token（提高 API 速率限制 60→5000/h）
GITHUB_TOKEN=

# 可选：HTTP/HTTPS 代理。config.yaml 中以 ${HTTPS_PROXY} 引用。
# 不需要代理（如 Linux 服务器在境外）就保持注释/留空 —— 程序自动不走代理。
# HTTPS_PROXY=http://127.0.0.1:1087
# HTTP_PROXY=http://127.0.0.1:1087
